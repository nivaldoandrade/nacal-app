{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nacal-app",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "app.nacal.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
